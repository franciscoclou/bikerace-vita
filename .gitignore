# --- build output ---
build/
build-*/
*.velf
*.self
*.vpk
eboot.bin
param.sfo

# --- the original game, and anything extracted from it ---
# Never commit these. apk/ is the unpacked retail APK; data/*.bin is level
# geometry and font atlases baked out of it. Both are needed to build and
# neither is ours to redistribute -- see the disclaimer in README.md.
apk/
data/*.bin

# --- derived artifacts, regenerated by scripts/ ---
# decompiled/ : scripts/decompile.sh
# tools/      : scripts/setup.sh
# assets_out/ : scripts/extract_assets.sh
decompiled/
tools/
assets_out/

# --- runtime debugging artifacts ---
debug.log
debug-*.log
psp2core-*.psp2dmp
dumps/*.psp2dmp
dumps/*.txt

# --- local overrides ---
# Per-machine IPs etc. See scripts/env.sh.
scripts/env.local.sh

# --- editor / os ---
.vscode/
.idea/
.cache/
compile_commands.json
*.o
*.a
.DS_Store

# --- level dumper build output ---
tools/leveldump/classes/
tests/test_game
tests/screenshot
